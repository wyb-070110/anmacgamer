    <string name="about_title">About</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_text">The companion app works with anmacgamer on your computer: it shows the computer\'s cursor and key hints on this phone, lets you type with the computer\'s keyboard, and without USB debugging it connects over Wi-Fi and sends the picture and sound to the computer.</string>
    <string name="about_help">Help and instructions</string>
    <string name="about_help_link" translatable="false">https://github.com/NuoRan/GameScrcpy</string>
    <string name="about_privacy">Privacy</string>
    <string name="about_privacy_text">The companion talks only to anmacgamer on your own computers, over USB debugging or your Wi-Fi. It collects nothing and sends nothing anywhere else.</string>
